# CivilDialog Backend — environment template
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed.


# --- Database (Member 5) ---------------------------------------------------
# PostgreSQL connection string used by SQLAlchemy and Alembic.
# Driver must be `psycopg` (psycopg 3), not `psycopg2`.
#
# Matches the credentials in docker-compose.yml:
#     docker compose up -d db
DATABASE_URL=postgresql+psycopg://civildialog:civildialog@localhost:5432/civildialog


# --- Authentication (Member 1) ---------------------------------------------
# Required. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# --- AI / NLP module (Member 3) --------------------------------------------
# Required. Absolute path to the CivilDialog-AI directory, which is added to
# sys.path by app/services/nlp_service.py so that `src.pipeline` is importable.
NLP_MODULE_PATH=../CivilDialog-AI


# --- LLM service (Member 4) ------------------------------------------------
# Base URL of the standalone LLM/rewrite FastAPI service.
LLM_SERVICE_URL=http://127.0.0.1:8001
